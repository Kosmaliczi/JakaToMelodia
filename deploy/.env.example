# Skopiuj jako .env w katalogu projektu, wypełnij i NIE commituj.
# `docker compose -f docker-compose.prod.yml up -d` automatycznie zaciągnie wartości.

# === Spotify ===
# Po obróceniu sekretu w https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# === Domena ===
# Adres pod którym appka jest dostępna publicznie. MUSI być zarejestrowany
# w Spotify Dashboard jako redirect URI:
#   https://twoja-domena.tld/login/oauth2/code/wolfship-auth
PUBLIC_DOMAIN=jakatomelodia.duckdns.org

# === JWT secret ===
# Wygeneruj raz, zapisz. Min 32 bajty. Przykład:
#   openssl rand -base64 48
# Bez tego graczom wylatują tokeny po każdym restarcie kontenera.
MELODIA_JWT_SECRET=
