# Skopiuj jako `.env` w tym samym katalogu i wypełnij. NIE commituj — `.env` jest w .gitignore.
# Docker Compose automatycznie zaciąga to przy `docker compose up`.

# === Spotify (WYMAGANE) ===
# Z https://developer.spotify.com/dashboard → twoja aplikacja.
# Client Secret rotujesz w "Edit Settings → Rotate Client Secret".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# === LAN host IP (zalecane do trybu multi-device) ===
# Kontener Docker nie widzi WiFi hosta — bez tego QR code w lobby pokaże
# Docker bridge IP (172.x.x.x), którego telefony nie zeskanują skutecznie.
# Znajdź swój IP:
#   Windows:  ipconfig | Select-String "IPv4"
#   Linux:    ip addr | grep "inet " | grep -v 127.0.0.1
#   macOS:    ipconfig getifaddr en0
# Możesz podać kilka rozdzielonych przecinkiem (WiFi + Ethernet).
MELODIA_HOST_LAN_IP=192.168.1.50

# === JWT (opcjonalne dla lokalnego dev) ===
# Bez tego sekret jest generowany przy każdym starcie kontenera = wyrzuca graczy.
# Wygeneruj (Linux/macOS): openssl rand -base64 48
MELODIA_JWT_SECRET=

# === Cookie Secure ===
# Lokalnie HTTP — zostaw false. Za HTTPS proxy (Cloudflare Tunnel, prod) ustaw true.
MELODIA_COOKIE_SECURE=false
